# Copie para .env (o .env NÃO vai para o Git).
NEO4J_PASSWORD=troque-esta-senha

# Opcionais
NEO4J_URI=bolt://localhost:7687
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_HEAP_MAX=2G
NEO4J_PAGECACHE=512m

# API (opcionais)
# API_FONTE=exemplo devolve o JSON de exemplo; recuperacao chama API_RESPONDER (modulo:funcao)
API_FONTE=exemplo
API_RESPONDER=
API_TIMEOUT_S=60
API_CORS_ORIGENS=http://localhost:8501,http://127.0.0.1:8501
# Chaves de LLM: preencha só no seu .env, nunca neste arquivo
ABACUS_API_KEY=
GROQ_API_KEY=
